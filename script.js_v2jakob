// 1. GLOBAL STATE
window.vizState = {
    selectedCountry: "Austria",
    selectedYear: 2012,
    selectedContinent: "Europe",
    data: null
};

// 2. CENTRAL UPDATE FUNCTION
function updateAllPlots() {
    const yearLabel = document.getElementById("select_year-value");
    if (yearLabel) yearLabel.innerText = window.vizState.selectedYear;

    if (typeof updateMap === "function") updateMap();
    if (typeof updateWaterfall === "function") updateWaterfall();
    if (typeof updateChart === "function") updateChart(); 
}

// 3. DATA LOADING
d3.text("./merged(2).csv").then(raw => {
    const data = d3.dsvFormat(";").parse(raw, d => ({
        region: d.continent,
        country: d["Country Name"],
        year: +d.Year,
        exportsval: +d["Exports of goods and services (constant 2015 USD)"],
        importsval: +d["Imports of goods and services (constant 2015 USD)"]
    }));

    window.vizState.data = data;

    document.getElementById("select_continent").addEventListener("change", (e) => {
        window.vizState.selectedContinent = e.target.value;
        updateAllPlots();
    });

    document.getElementById("select_year").addEventListener("input", (e) => {
        window.vizState.selectedYear = +e.target.value;
        updateAllPlots();
    });

    updateAllPlots();
});

// 4. BAR CHART LOGIC
function updateChart() {
    const data = window.vizState.data;
    const selectedRegion = window.vizState.selectedContinent;
    const selectedYear = window.vizState.selectedYear;

    if (!data) return;

    let newData = data
        .filter(d => (selectedRegion === "All" || d.region === selectedRegion) && d.year === selectedYear)
        .filter(d => Number.isFinite(d.exportsval) && Number.isFinite(d.importsval))
        .filter(d => d.exportsval > 0 || d.importsval > 0);

    const maxAbs = d3.max(newData, d => Math.max(Math.abs(d.exportsval), Math.abs(d.importsval))) || 1;

    d3.select("#bar_chart").selectAll("svg").remove();
    if(newData.length > 0) {
        createVerticalDivergingBarChart(newData, maxAbs);
    }
}

const createVerticalDivergingBarChart = (data, maxAbs) => {
    const container = d3.select("#bar_chart").node();
    const width = container ? container.getBoundingClientRect().width : 900;
    const height = Math.max(500, data.length * 25); // Responsive height based on data
    const margins = { top: 20, right: 30, bottom: 60, left: 150 };

    const svg = d3.select("#bar_chart")
        .append("svg")
        .attr("width", width)
        .attr("height", height);

    const yScale = d3.scaleBand()
        .domain(data.map(d => d.country))
        .range([margins.top, height - margins.bottom])
        .padding(0.3);

    const xScale = d3.scaleLinear()
        .domain([-maxAbs, maxAbs])
        .range([margins.left, width - margins.right]);

    const tooltip = d3.select("#tooltip");
    const chartArea = svg.append("g");

    // Helper to highlight selected country (Linking Task)
    const getStroke = (d) => d.country === window.vizState.selectedCountry ? "#000" : "none";
    const getStrokeW = (d) => d.country === window.vizState.selectedCountry ? 2 : 0;

    // EXPORT BARS
    chartArea.selectAll("rect.export")
        .data(data)
        .join("rect")
        .attr("class", "export")
        .attr("y", d => yScale(d.country))
        .attr("x", xScale(0))
        .attr("width", d => Math.abs(xScale(d.exportsval) - xScale(0)))
        .attr("height", yScale.bandwidth())
        .attr("fill", "#ff6600")
        .attr("stroke", getStroke)
        .attr("stroke-width", getStrokeW)
        .on("mouseover", (event, d) => {
            tooltip.style("opacity", 1).html(`<strong>${d.country}</strong><br/>Export: ${(d.exportsval / 1e9).toFixed(2)}B`);
        })
        .on("mousemove", (event) => {
            tooltip.style("left", (event.pageX + 10) + "px").style("top", (event.pageY - 20) + "px");
        })
        .on("mouseout", () => tooltip.style("opacity", 0));

    // IMPORT BARS
    chartArea.selectAll("rect.import")
        .data(data)
        .join("rect")
        .attr("class", "import")
        .attr("y", d => yScale(d.country))
        .attr("x", d => xScale(-d.importsval))
        .attr("width", d => Math.abs(xScale(0) - xScale(-d.importsval)))
        .attr("height", yScale.bandwidth())
        .attr("fill", "#808080")
        .attr("stroke", getStroke)
        .attr("stroke-width", getStrokeW)
        .on("mouseover", (event, d) => {
            tooltip.style("opacity", 1).html(`<strong>${d.country}</strong><br/>Import: ${(d.importsval / 1e9).toFixed(2)}B`);
        })
        .on("mousemove", (event) => {
            tooltip.style("left", (event.pageX + 10) + "px").style("top", (event.pageY - 20) + "px");
        })
        .on("mouseout", () => tooltip.style("opacity", 0));

    // AXES
    svg.append("g")
        .attr("transform", `translate(0,${height - margins.bottom})`)
        .call(d3.axisBottom(xScale).tickFormat(d => (Math.abs(d) / 1e9) + "B"));

    svg.append("g")
        .attr("transform", `translate(${xScale(0)},0)`)
        .call(d3.axisLeft(yScale).tickSize(0).tickPadding(10));
};

// TAB REDRAW FIX
document.getElementById('bar-tab').addEventListener('shown.bs.tab', function () {
    updateChart(); 
});
